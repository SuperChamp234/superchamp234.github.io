---
layout: base.njk
---

<div class="blog-page">
    <header class="page-header">
        <h1>Notes, mostly technical.</h1>
        <p class="lede">Long-form notes on compilers, computer architecture, verification, FPGA tooling, and the occasional detour. {{ collections.posts.length }} posts and counting.</p>
    </header>

    {% set years = collections.posts | groupByYear %}
    {% for group in years %}
    <section class="year-group" aria-labelledby="year-{{ group.year }}">
        <h2 class="year-label" id="year-{{ group.year }}">{{ group.year }}</h2>
        <div class="post-list">
            {% for post in group.posts %}
            <a class="post-row" href="{{ post.url }}">
                <time datetime="{{ post.date | htmlDateString }}">{{ post.date | blogDate }}</time>
                <span class="post-row-main">
                    <span class="post-row-title">{{ post.data.title }}</span>
                    <span class="post-row-excerpt">{{ post.templateContent | excerpt(150) }}</span>
                </span>
                <span class="post-row-meta">{{ post.templateContent | readingTime }} min</span>
            </a>
            {% endfor %}
        </div>
    </section>
    {% endfor %}

    {% if not collections.posts.length %}
    <p class="empty-state">No posts yet. The first one is probably about a bug.</p>
    {% endif %}
</div>
