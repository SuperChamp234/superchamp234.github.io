{% import "icons.njk" as icons %}
<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-brand">
            <a class="footer-wordmark" href="/">{{ site.title }}</a>
            <p>{{ site.description }}</p>
        </div>

        <nav class="footer-links" aria-label="Footer">
            <p class="footer-label">Pages</p>
            <a href="/">Home</a>
            <a href="/blog/">Blog</a>
            <a href="/gallery/">Gallery</a>
            <a href="/resume/">Resume</a>
            <a href="/feed.xml">RSS</a>
        </nav>

        <div class="footer-social">
            <p class="footer-label">Elsewhere</p>
            {% for link in homepage.social_links %}
            <a href="{{ link.url }}" target="_blank" rel="noopener">
                {{ icons.icon(link.icon, 16) }}
                <span>{{ link.title }}</span>
            </a>
            {% endfor %}
            <a href="mailto:{{ homepage.email }}">
                {{ icons.icon("mail", 16) }}
                <span>Email</span>
            </a>
        </div>
    </div>

    <div class="footer-base">
        <p>© {{ buildYear }} {{ site.author }}</p>
        <p>Built with <a href="https://www.11ty.dev/" target="_blank" rel="noopener">Eleventy</a>. Set in Fraunces &amp; system sans.</p>
    </div>
</footer>
