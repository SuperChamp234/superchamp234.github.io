---
layout: base.njk
pageScripts:
  - /js/typed.min.js
  - /js/home.js
---

<div class="home">
    <section class="home-hero">
        <div class="home-copy">
            <h1 class="home-title">Zain<br> Siddavatam</h1>
            <p class="home-line">
                <span>I am </span><span id="typed" class="typed" aria-hidden="true" data-strings='{{ homepage.typed_strings | dump }}'></span><span class="sr-only">{{ homepage.tagline }}</span>
            </p>
            <p class="home-intro">{{ homepage.intro | safe }}</p>
        </div>

        <figure class="home-figure">
            <div class="home-photo">
                {% if hero %}
                <picture>
                    <source type="image/avif" srcset="{{ hero.srcset.avif }}" sizes="(max-width: 820px) 100vw, 40vw">
                    <source type="image/webp" srcset="{{ hero.srcset.webp }}" sizes="(max-width: 820px) 100vw, 40vw">
                    <img src="{{ hero.fallback }}" srcset="{{ hero.srcset.jpg }}" sizes="(max-width: 820px) 100vw, 40vw" width="{{ hero.width }}" height="{{ hero.height }}" alt="{{ homepage.hero_alt }}" fetchpriority="high" decoding="async">
                </picture>
                {% endif %}
            </div>
            <figcaption>{{ homepage.hero_caption }}</figcaption>
        </figure>
    </section>

    <section class="box home-now" aria-labelledby="now-heading">
        <h2 class="box-head" id="now-heading">Now</h2>
        <div class="box-body">
            <ul class="now-list">
                {% for item in homepage.current_activities %}
                <li>{{ item | safe }}</li>
                {% endfor %}
            </ul>
        </div>
    </section>
</div>
