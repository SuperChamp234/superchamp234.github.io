---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
    <title>{{ site.title | escape }}</title>
    <subtitle>{{ site.description | escape }}</subtitle>
    <link href="{{ site.url }}/feed.xml" rel="self"/>
    <link href="{{ site.url }}/"/>
    <updated>{% if collections.posts.length %}{{ collections.posts[0].date | sitemapDateString }}{% endif %}</updated>
    <id>{{ site.url }}/</id>
    <author>
        <name>{{ site.author | escape }}</name>
        <email>{{ site.email }}</email>
    </author>
    {% for post in collections.posts %}
    <entry>
        <title>{{ post.data.title | escape }}</title>
        <link href="{{ site.url }}{{ post.url }}"/>
        <updated>{{ post.date | sitemapDateString }}</updated>
        <id>{{ site.url }}{{ post.url }}</id>
        {% set summary = post.data.description or (post.templateContent | excerpt(220)) %}
        <summary>{{ summary | escape }}</summary>
    </entry>
    {% endfor %}
</feed>
